# ==============================================================================
# INCIDENTPILOT CONFIGURATION (.env)
# ==============================================================================

# LLM API Key (OpenAI, OpenRouter, Groq, DeepSeek, or any OpenAI-compatible provider)
LLM_API_KEY=
OPENAI_API_KEY=

# LLM Model Name (e.g., gpt-4o, gpt-4o-mini, deepseek/deepseek-chat, claude-3-5-sonnet)
LLM_MODEL=gpt-4o

# Optional Custom Base URL (leave empty for OpenAI default: https://api.openai.com/v1)
# For OpenRouter: https://openrouter.ai/api/v1
# For Ollama / local vLLM: http://localhost:11434/v1
LLM_BASE_URL=
